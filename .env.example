# AgentMemory Configuration
# Copy this file to .env and fill in your values.

# OpenRouter API key (required for classification/embedding in Phase 1+)
OPENROUTER_API_KEY=

# TypeSafe JEV base URL — routes all JEV calls through OpenRouter
# (exact replication of TypeSafe's JEV endpoint routes)
TYPESAFE_BASE_URL=https://openrouter.ai/api

# Postgres connection string
# Default (Docker Compose):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agent_memory;Username=agent_memory;Password=agent_memory

# Local development (standalone Postgres):
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agent_memory;Username=agent_memory;Password=agent_memory

# Server URL (used by hooks)
SERVER_URL=http://localhost:5098