# AgentMemory Configuration
# Copy this file to .env and fill in your values.

# OpenRouter API key (required for classification/embedding)
OPENROUTER_API_KEY=

# OpenRouter API base URL — override only for a self-hosted proxy or test double.
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Model used for the classify (category + save-worthiness) call.
# Must be a real OpenRouter model id (provider/model) that supports JSON-mode
# response_format. Default: a cheap, fast instruction model.
OPENROUTER_CLASSIFICATION_MODEL=openai/gpt-4o-mini

# Model used to embed content that clears the save threshold.
# Must be a real OpenRouter model id; the pgvector column is sized for 1536
# dimensions (text-embedding-3-small's native size) — changing to a model with a
# different dimension count requires updating the `memories.embedding` column type.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Postgres connection string
# Default (Docker Compose):
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agent_memory;Username=agent_memory;Password=agent_memory

# Local development (standalone Postgres):
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agent_memory;Username=agent_memory;Password=agent_memory

# Minimum save-worthiness score (0-4) a capture must clear to be embedded and
# promoted to a memory. Below-threshold captures are still kept in `captures`
# for later re-classification/tuning — see docs/dev plan.md "Retention policy".
Memory__SaveThreshold=0.5

# Server URL (used by hooks)
SERVER_URL=http://localhost:5098
