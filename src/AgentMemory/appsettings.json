{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=agent_memory;Username=agent_memory;Password=agent_memory"
  },
  "Memory": {
    // Phase 2a: Threshold is on the 0-4 scale (was 0.5 on 0-4, which filtered nothing).
    // Meaning: 0 = trivial/ephemeral, 4 = essential project knowledge.
    "SaveThreshold": 2.5,
    // Phase 1c: Server-side denylist backstop — tool names whose captures are
    // rejected immediately (even if the hook's allowlist misses them).
    "IgnoredTools": [
      "Read", "Glob", "Grep", "ToolSearch", "Fetch", "WebSearch", "WebFetch",
      "Browse", "AskUser", "AskQuestion"
    ],
    // Phase 1d: Minimum-content gate configuration (server-side, before LLM call).
    "Gate": {
      "MinWords": 3,
      "RejectionPatterns": [
        "yes, commit and push",
        "yes",
        "ok",
        "go ahead",
        "commit and push",
        "done",
        "proceed",
        "continue"
      ]
    },
    // Phase 3: Deduplication threshold (cosine similarity, 0-1).
    // At 0.92, pgvector/HNSW decisions collapse into one memory.
    "DedupSimilarity": 0.92
  },
  "OpenRouter": {
    "BaseUrl": "https://openrouter.ai/api",
    "ClassificationModel": "openai/gpt-4o-mini",
    "EmbeddingModel": "openai/text-embedding-3-small"
  }
}