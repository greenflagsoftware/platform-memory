{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AgentMemory": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=agent_memory;Username=agent_memory;Password=agent_memory;Include Error Detail=true"
  },
  "Memory": {
    // Phase 2a: Raise dev threshold to 2.5 (was 0.3, far too permissive).
    "SaveThreshold": 2.5,
    "IgnoredTools": [
      "Read", "Glob", "Grep", "ToolSearch", "Fetch", "WebSearch", "WebFetch",
      "Browse", "AskUser", "AskQuestion"
    ],
    "Gate": {
      "MinWords": 3,
      "RejectionPatterns": [
        "yes, commit and push",
        "yes",
        "ok",
        "go ahead",
        "commit and push",
        "done",
        "proceed",
        "continue"
      ]
    },
    "DedupSimilarity": 0.92
  }
}